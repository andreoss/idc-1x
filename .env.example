# IDC Catalog Service Configuration

# PostgreSQL connection string (required)
# Format: postgresql://user:pass@host:port/dbname
PG_CONN=postgresql://postgres:postgres@localhost:5432/idc_catalog

# HTTP server port
PORT=8080

# Seed data directory (CSV files location)
SEED_DIR=seed

# Database connection pool size
POOL_SIZE=10

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Feature flags
ENABLE_CACHE=true
ENABLE_METRICS=false